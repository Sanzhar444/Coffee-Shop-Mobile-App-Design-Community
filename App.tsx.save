import React, { useMemo, useState } from 'react';
import {
  View,
  Text,
  StyleSheet,
  ScrollView,
  TextInput,
  Pressable,
  StatusBar,
  SafeAreaView,
} from 'react-native';

type Coffee = {
  id: number;
  name: string;
  description: string;
  price: number;
  category: string;
  emoji: string;
};

const coffees: Coffee[] = [
  {
    id: 1,
    name: 'Капучино',
    description: 'Эспрессо, молоко и нежная пенка',
    price: 1200,
    category: 'Кофе',
    emoji: '☕',
  },
  {
    id: 2,
    name: 'Латте',
    description: 'Мягкий вкус и молочная текстура',
    price: 1400,
    category: 'Кофе',
    emoji: '🥛',
  },
  {
    id: 3,
    name: 'Американо',
    description: 'Крепкий кофе с горячей водой',
    price: 1000,
    category: 'Кофе',
    emoji: '☕',
  },
  {
    id: 4,
    name: 'Мокка',
    description: 'Кофе, шоколад и молоко',
    price: 1600,
    category: 'Шоколад',
    emoji: '🍫',
  },
  {
    id: 5,
    name: 'Айс-латте',
    description: 'Освежающий холодный кофе',
    price: 1500,
    category: 'Холодный',
    emoji: '🧋',
  },
  {
    id: 6,
    name: 'Эспрессо',
    description: 'Насыщенный классический кофе',
    price: 900,
    category: 'Кофе',
    emoji: '☕',
  },
];

const categories = ['Все', 'Кофе', 'Шоколад', 'Холодный'];

export default function App() {
  const [search, setSearch] = useState('');
  const [selectedCategory, setSelectedCategory] = useState('Все');
  const [cart, setCart] = useState<number[]>([]);
  const [activeTab, setActiveTab] = useState('Главная');

  const filteredCoffees = useMemo(() => {
    return coffees.filter((coffee) => {
      const matchesCategory =
        selectedCategory === 'Все' ||
        coffee.category === selectedCategory;

      const matchesSearch = coffee.name
        .toLowerCase()
        .includes(search.toLowerCase());

      return matchesCategory && matchesSearch;
    });
  }, [search, selectedCategory]);

  const addToCart = (id: number) => {
    setCart((previous) => [...previous, id]);
  };

  const totalPrice = cart.reduce((sum, id) => {
    const coffee = coffees.find((item) => item.id === id);
    return sum + (coffee?.price || 0);
  }, 0);

  const renderHome = () => (
    <>
      <View style={styles.header}>
        <View>
          <Text style={styles.locationLabel}>ВАШЕ МЕСТОПОЛОЖЕНИЕ</Text>
          <Text style={styles.location}>Алматы, Казахстан ⌄</Text>
        </View>

        <View style={styles.avatar}>
          <Text style={styles.avatarText}>☕</Text>
        </View>
      </View>

      <View style={styles.greeting}>
        <Text style={styles.greetingSmall}>Добро пожаловать!</Text>
        <Text style={styles.greetingTitle}>
          Найдите свой идеальный кофе
        </Text>
      </View>

      <View style={styles.searchBox}>
        <Text style={styles.searchIcon}>⌕</Text>
        <TextInput
          style={styles.searchInput}
          placeholder="Поиск кофе..."
          placeholderTextColor="#A69A8D"
          value={search}
          onChangeText={setSearch}
        />
      </View>

      <View style={styles.banner}>
        <View style={styles.bannerContent}>
          <Text style={styles.bannerTag}>СПЕЦИАЛЬНОЕ ПРЕДЛОЖЕНИЕ</Text>
          <Text style={styles.bannerTitle}>
            Время для хорошего кофе
          </Text>
          <Text style={styles.bannerDescription}>
            Получите скидку 20% на первый заказ
          </Text>
          <View style={styles.bannerButton}>
            <Text style={styles.bannerButtonText}>WELCOME20</Text>
          </View>
        </View>

        <Text style={styles.bannerCoffee}>☕</Text>
      </View>

      <View style={styles.sectionHeader}>
        <Text style={styles.sectionTitle}>Категории</Text>
        <Text style={styles.sectionSubtitle}>Выберите напиток</Text>
      </View>

      <ScrollView
        horizontal
        showsHorizontalScrollIndicator={false}
        contentContainerStyle={styles.categories}
      >
        {categories.map((category) => (
          <Pressable
            key={category}
            onPress={() => setSelectedCategory(category)}
            style={[
              styles.category,
              selectedCategory === category && styles.categoryActive,
            ]}
          >
            <Text
              style={[
                styles.categoryText,
                selectedCategory === category &&
                  styles.categoryTextActive,
              ]}
            >
              {category}
            </Text>
          </Pressable>
        ))}
      </ScrollView>

      <View style={styles.sectionHeader}>
        <Text style={styles.sectionTitle}>Популярные напитки</Text>
        <Text style={styles.sectionSubtitle}>
          {filteredCoffees.length} напитков
        </Text>
      </View>

      <View style={styles.productGrid}>
        {filteredCoffees.map((coffee) => (
          <View style={styles.productCard} key={coffee.id}>
            <View style={styles.productImage}>
              <Text style={styles.productEmoji}>{coffee.emoji}</Text>
              <View style={styles.rating}>
                <Text style={styles.ratingText}>★ 4.9</Text>
              </View>
            </View>

            <Text style={styles.productName}>{coffee.name}</Text>
            <Text style={styles.productDescription}>
              {coffee.description}
            </Text>

            <View style={styles.productBottom}>
              <Text style={styles.productPrice}>
                {coffee.price.toLocaleString('ru-RU')} ₸
              </Text>

              <Pressable
                style={styles.addButton}
                onPress={() => addToCart(coffee.id)}
              >
                <Text style={styles.addButtonText}>+</Text>
              </Pressable>
            </View>
          </View>
        ))}
      </View>

      {filteredCoffees.length === 0 && (
        <Text style={styles.emptyText}>
          Ничего не найдено. Попробуйте другой запрос.
        </Text>
      )}
    </>
  );

  const renderCart = () => {
    const cartItems = cart.map((id, index) => ({
      ...coffees.find((coffee) => coffee.id === id)!,
      cartIndex: index,
    }));

    return (
      <View style={styles.otherScreen}>
        <Text style={styles.otherTitle}>Моя корзина</Text>

        {cartItems.length === 0 ? (
          <View style={styles.emptyCart}>
            <Text style={styles.emptyCartEmoji}>🛍️</Text>
            <Text style={styles.emptyCartTitle}>Корзина пуста</Text>
            <Text style={styles.emptyCartText}>
              Добавьте любимый кофе из каталога
            </Text>
          </View>
        ) : (
          <>
            {cartItems.map((item) => (
              <View style={styles.cartItem} key={item.cartIndex}>
                <Text style={styles.cartEmoji}>{item.emoji}</Text>
                <View style={styles.cartInfo}>
                  <Text style={styles.cartName}>{item.name}</Text>
                  <Text style={styles.cartPrice}>
                    {item.price.toLocaleString('ru-RU')} ₸
                  </Text>
                </View>
                <Pressable
                  onPress={() =>
                    setCart((previous) =>
                      previous.filter((_, index) => index !== item.cartIndex)
                    )
                  }
                  style={styles.removeButton}
                >
                  <Text style={styles.removeButtonText}>−</Text>
                </Pressable>
              </View>
            ))}

            <View style={styles.totalRow}>
              <Text style={styles.totalLabel}>Итого</Text>
              <Text style={styles.totalPrice}>
                {totalPrice.toLocaleString('ru-RU')} ₸
              </Text>
            </View>

            <Pressable style={styles.checkoutButton}>
              <Text style={styles.checkoutText}>Оформить заказ</Text>
            </Pressable>
          </>
        )}
      </View>
    );
  };

  const renderProfile = () => (
    <View style={styles.otherScreen}>
      <Text style={styles.otherTitle}>Мой профиль</Text>
      <View style={styles.profileCard}>
        <View style={styles.profileAvatar}>
          <Text style={styles.profileAvatarText}>👤</Text>
        </View>
        <Text style={styles.profileName}>Гость</Text>
        <Text style={styles.profileDescription}>
          Войдите в аккаунт, чтобы сохранять заказы
        </Text>
        <Pressable style={styles.checkoutButton}>
          <Text style={styles.checkoutText}>Войти в аккаунт</Text>
        </Pressable>
      </View>
    </View>
  );

  return (
    <SafeAreaView style={styles.container}>
      <StatusBar barStyle="dark-content" backgroundColor="#F8F4EF" />

      <ScrollView
        showsVerticalScrollIndicator={false}
        contentContainerStyle={styles.scrollContent}
      >
        {activeTab === 'Главная' && renderHome()}
        {activeTab === 'Корзина' && renderCart()}
        {activeTab === 'Профиль' && renderProfile()}
      </ScrollView>

      <View style={styles.bottomBar}>
        {[
          { name: 'Главная', icon: '⌂' },
          { name: 'Корзина', icon: '🛍' },
          { name: 'Профиль', icon: '♙' },
        ].map((tab) => (
          <Pressable
            key={tab.name}
            style={styles.tab}
            onPress={() => setActiveTab(tab.name)}
          >
            <View>
              <Text
                style={[
                  styles.tabIcon,
                  activeTab === tab.name && styles.tabActive,
                ]}
              >
                {tab.icon}
              </Text>
              {tab.name === 'Корзина' && cart.length > 0 && (
                <View style={styles.cartBadge}>
                  <Text style={styles.cartBadgeText}>{cart.length}</Text>
                </View>
              )}
            </View>
            <Text
              style={[
                styles.tabText,
                activeTab === tab.name && styles.tabTextActive,
              ]}
            >
              {tab.name}
            </Text>
          </Pressable>
        ))}
      </View>
    </SafeAreaView>
  );
}

